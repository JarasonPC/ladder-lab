msgid "%d place where rooms overlap: drag them apart"
msgid_plural "%d places where rooms overlap: drag them apart"
msgstr[0] "%d místo, kde se místnosti překrývají: odtáhněte je od sebe"
msgstr[1] "%d místa, kde se místnosti překrývají: odtáhněte je od sebe"
msgstr[2] "%d míst, kde se místnosti překrývají: odtáhněte je od sebe"

