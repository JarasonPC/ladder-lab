msgid "Rename the terminals, e.g. 13-14 to 53-54. Empty restores the standard marking."
msgstr "Přejmenování svorek, např. 13-14 na 53-54. Prázdné pole obnoví normalizované značení."

msgid "Swap"
msgstr "Prohodit"

msgid "Swap the terminal names, e.g. A1-A2 to A2-A1"
msgstr "Prohodit označení svorek, např. A1-A2 na A2-A1"

msgid "The designation must not be empty."
msgstr "Označení nesmí být prázdné."

msgid "Terminal names must all be different, without spaces or colons."
msgstr "Označení svorek se musí navzájem lišit a nesmí obsahovat mezery ani dvojtečky."

