msgstr "Ethernetový port %s je propojen s %s: ethernetový kabel spojuje jen dva porty."

#, c-format
msgid "The Ethernet cable from %s joins %s ports: more than two are joined only through a network switch."
msgstr "Ethernetový kabel z %s spojuje %s portů: víc než dva se spojují jen přes síťový přepínač."

#, c-format
msgid "PLCs %s and %s have the same IP address %s on one network."
msgstr "PLC %s a %s mají v jedné síti stejnou IP adresu %s."

#, c-format
msgid "Network input %s of %s reads from %s, but no PLC on its network has that IP address."
msgstr "Síťový vstup %s automatu %s čte z %s, ale žádné PLC v jeho síti tuto IP adresu nemá."

#, c-format
msgid "Network input %s of %s reads from %s (%s), which is not on its subnet (%s, mask %s)."
msgstr "Síťový vstup %s automatu %s čte z %s (%s), který není v jeho podsíti (%s, maska %s)."

