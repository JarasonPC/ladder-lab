msgstr "Zrcadlit podle osy značky (F)"

msgid "Delete"
msgstr "Smazat"

msgid "Step"
msgstr "Krok"

msgid "Advance the simulation by 0.1 s"
msgstr "Posunout simulaci o 0,1 s"

msgid "Speed:"
msgstr "Rychlost:"

msgid "Reset"
msgstr "Reset"

msgid "Restart the simulation from the initial state"
msgstr "Spustit simulaci znovu od výchozího stavu"

