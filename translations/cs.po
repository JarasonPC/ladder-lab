msgstr "Úbytek napětí %s V (%s %% z %d V) při %s A."

msgid "More than the %s %% usually kept to: a larger cross-section is needed."
msgstr "Víc než obvykle dodržovaných %s %%: je potřeba větší průřez."

msgid "Load (% of rated torque)"
msgstr "Zatížení (% jmenovitého momentu)"

msgid "Rated torque %s N·m. The load needs a quarter of it at standstill, the rest grows with the square of the speed (fan, pump)."
msgstr "Jmenovitý moment %s N·m. Zátěž potřebuje v klidu čtvrtinu, zbytek roste s druhou mocninou otáček (ventilátor, čerpadlo)."

msgid "Show as a tile"
msgstr "Zobrazit jako dlaždici"

msgid "Show as the control station"
msgstr "Zobrazit jako ovládací skříňku"

msgid "Shown as the station itself, its buttons and switches work on the workspace while simulating; drag its corner to size it"
msgstr "Zobrazí skříňku samotnou, její tlačítka a přepínače při simulaci fungují přímo na pracovní ploše; tažením za roh změníte velikost"

msgid "Choose what the timing chart shows"
msgstr "Vybrat, co časový diagram ukazuje"

msgid "Show all"
msgstr "Zobrazit vše"

msgid "Hide all"
msgstr "Skrýt vše"

