#, c-format
msgid "Terminals: %s"
msgstr "Svorky: %s"

msgid "The designation must not be empty."
msgstr "Označení nesmí být prázdné."

#, c-format
msgid "%s is already used in this circuit."
msgstr "Označení %s je v tomto obvodu již použito."

msgid "Click to place. R rotates, F mirrors. Right click or Esc stops placing."
msgstr "Kliknutím prvek umístíte. R otočí, F zrcadlí. Pravým tlačítkem myši nebo Esc vkládání ukončíte."

msgid "Click empty cells for corners, finish on a terminal or a wire. Backspace removes a corner, Esc cancels."
msgstr "Kliknutím do prázdných polí přidáte lomy, kreslení ukončíte na svorce nebo vodiči. Backspace odebere lom, Esc zruší."

msgid "Click a terminal to draw a wire. Drag to move. R rotates, F mirrors, Del deletes, Ctrl+Z undoes."
msgstr "Kliknutím na svorku nakreslíte vodič. Tažením přesunete. R otočí, F zrcadlí, Del smaže, Ctrl+Z vrátí zpět."

msgid "Edit"
msgstr "Úpravy"

msgid "Simulate"
msgstr "Simulace"

msgid "Circuit:"
msgstr "Obvod:"

msgid "New"
msgstr "Nový"

msgid "Start an empty schematic with L and N supplies"
msgstr "Založit prázdné schéma s přívody L a N"

