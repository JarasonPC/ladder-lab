msgstr "Otočit o čtvrt doleva (Shift+R)"

msgid "Mirror left to right (F)"
msgstr "Zrcadlit zleva doprava (F)"

msgid "Mirror top to bottom (Shift+F)"
msgstr "Zrcadlit shora dolů (Shift+F)"

