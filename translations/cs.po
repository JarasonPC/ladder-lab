msgstr "Vybrat a spojit"

msgid "Input I"
msgstr "Vstup I"

msgid "Output Q"
msgstr "Výstup Q"

msgid "Flag M"
msgstr "Příznak (merker) M"

msgid "Constant 1 (hi)"
msgstr "Konstanta 1 (hi)"

msgid "Constant 0 (lo)"
msgstr "Konstanta 0 (lo)"

msgid "AND"
msgstr "AND"

msgid "OR"
msgstr "OR"

msgid "NOT"
msgstr "NOT"

msgid "NAND"
msgstr "NAND"

msgid "NOR"
msgstr "NOR"

msgid "XOR"
msgstr "XOR"

msgid "On-delay"
msgstr "Zpoždění zapnutí"

msgid "Off-delay"
msgstr "Zpoždění vypnutí"

msgid "Latching relay"
msgstr "Paměťové relé"

msgid "Pulse relay"
msgstr "Impulzní relé"

msgid "Up/down counter"
msgstr "Vratný čítač"

msgid "Input"
msgstr "Vstup"

msgid "Flag"
msgstr "Příznak"

msgid "Brings an input of the PLC into the diagram: 1 while the input has voltage."
msgstr "Přivádí do schématu vstup PLC: 1, dokud má vstup napětí."

msgid "Switches an output relay of the PLC: its contact closes while the input of this block is 1. Its own output can be fed back."
msgstr "Spíná výstupní relé PLC: jeho kontakt je sepnutý, dokud je vstup tohoto bloku 1. Jeho vlastní výstup lze vést zpět."

msgid "Stores a signal as a flag M; its output can be used elsewhere in the diagram."
msgstr "Ukládá signál jako příznak M; jeho výstup lze použít jinde ve schématu."

msgid "A fixed signal 1 or 0."
msgstr "Pevný signál 1 nebo 0."

msgid "1 when all connected inputs are 1 (unconnected inputs count as 1)."
msgstr "1, když jsou všechny připojené vstupy 1 (nepřipojené vstupy se počítají jako 1)."

msgid "1 when at least one input is 1."
msgstr "1, když je alespoň jeden vstup 1."

msgid "Inverts its input."
msgstr "Neguje svůj vstup."

msgid "AND with an inverted output."
msgstr "AND s negovaným výstupem."

msgid "OR with an inverted output."
msgstr "OR s negovaným výstupem."

msgid "1 when exactly one of its two inputs is 1."
msgstr "1, když je právě jeden z obou vstupů 1."

msgid "The output comes on when the trigger Trg has been 1 for the time T; off with Trg."
msgstr "Výstup sepne, když byl spouštěcí vstup Trg 1 po dobu T; vypne se s Trg."

msgid "The output is on with the trigger Trg and goes off the time T after Trg went off; R switches it off at once."
msgstr "Výstup sepne s Trg a vypne se za dobu T po vypnutí Trg; R jej vypne ihned."

msgid "S sets the output, R resets it; R wins when both are 1."
msgstr "S výstup nastaví, R jej vynuluje; když jsou oba 1, má přednost R."

msgid "Every rising edge on Trg switches the output over; S sets it, R resets it (R wins)."
msgstr "Každá náběžná hrana na Trg výstup přepne; S jej nastaví, R vynuluje (R má přednost)."

msgid "Counts the rising edges on Cnt, up or down while Dir is 1; R sets the count to 0. The output is on while the count has reached the preset."
msgstr "Čítá náběžné hrany na Cnt, nahoru, nebo dolů, když je Dir 1; R vynuluje stav. Výstup je sepnutý, dokud stav dosahuje předvolby."

#, c-format
msgid "Network %d"
msgstr "Síť %d"

msgid "Select"
msgstr "Vybrat"

msgid "NO contact"
msgstr "Kontakt NO"

msgid "NC contact"
msgstr "Kontakt NC"

msgid "Branch (vertical link)"
msgstr "Větev (svislé spojení)"

msgid "Coil"
msgstr "Cívka"

msgid "Set coil"
msgstr "Cívka nastavení (S)"

msgid "Reset coil"
msgstr "Cívka nulování (R)"

msgid "On-delay timer"
msgstr "Časovač se zpožděním zapnutí"

msgid "Off-delay timer"
msgstr "Časovač se zpožděním vypnutí"

msgid "Count up"
msgstr "Čítání nahoru"

msgid "Count down"
msgstr "Čítání dolů"

msgid "Erase"
msgstr "Vymazat"

msgid "Network"
msgstr "Síť"

msgid "Closed while its operand is 1."
msgstr "Sepnutý, dokud je jeho operand 1."

msgid "Closed while its operand is 0."
msgstr "Sepnutý, dokud je jeho operand 0."

msgid "Passes the power on."
msgstr "Vede proud dál."

msgid "Its operand is 1 while the coil gets power."
msgstr "Jeho operand je 1, dokud cívka dostává proud."

msgid "Sets its operand to 1 when it gets power; it stays 1."
msgstr "Nastaví svůj operand na 1, když dostane proud; zůstane 1."

msgid "Resets its operand to 0 when it gets power (a timer stops, a counter goes back to 0)."
msgstr "Vynuluje svůj operand, když dostane proud (časovač se zastaví, čítač se vrátí na 0)."

msgid "The timer T comes on when the coil has had power for the time; off with the power."
msgstr "Časovač T sepne, když cívka dostávala proud po nastavenou dobu; vypne se s proudem."

msgid "The timer T is on with the power and goes off the time after the power went off."
msgstr "Časovač T sepne s proudem a vypne se za nastavenou dobu po jeho vypnutí."

msgid "Counts each time the coil gets power. The counter's contacts C close when the count has reached the preset."
msgstr "Načítá pokaždé, když cívka dostane proud. Kontakty čítače C sepnou, když stav dosáhne předvolby."

msgid "Stop simulation"
msgstr "Ukončit simulaci"

msgid "Test the program on its own: switch the inputs and watch the outputs"
msgstr "Vyzkoušejte program samostatně: přepínejte vstupy a sledujte výstupy"

msgid "Simulation: switch the inputs below; red is 1, blue is 0"
msgstr "Simulace: přepínejte vstupy dole; červená je 1, modrá je 0"

msgid "Middle or right drag (or Space+drag) pans, Ctrl+wheel zooms."
msgstr "Tažení prostředním nebo pravým tlačítkem (nebo s mezerníkem) posouvá, Ctrl+kolečko mění zvětšení."

msgid "Click an element to see its state."
msgstr "Klepnutím na prvek uvidíte jeho stav."

msgid "Drag an output (right) to an input (left) to connect; drag on empty paper to select several blocks."
msgstr "Tažením z výstupu (vpravo) na vstup (vlevo) bloky spojíte; tažením po prázdné ploše vyberete více bloků."

msgid "Click a place to select it; Delete removes it, Insert puts an empty row above it."
msgstr "Klepnutím místo vyberete; Delete jej vymaže, Insert nad něj vloží prázdný řádek."

msgid "Insert row"
msgstr "Vložit řádek"

msgid "An empty row above this one (Insert)"
msgstr "Prázdný řádek nad tímto (Insert)"

msgid "Delete row"
msgstr "Odstranit řádek"

msgid "Blocks selected"
msgstr "Vybrané bloky"

msgid "Drag one of them to move them all. Ctrl+C copies them, Ctrl+V pastes them at the mouse, Delete removes them."
msgstr "Tažením jednoho z nich přesunete všechny. Ctrl+C je zkopíruje, Ctrl+V je vloží u myši, Delete je odstraní."

msgid "Rising edge contact"
msgstr "Kontakt náběžné hrany"

msgid "Falling edge contact"
msgstr "Kontakt sestupné hrany"

msgid "Negated coil"
msgstr "Negovaná cívka"

msgid "Empty place"
msgstr "Prázdné místo"

msgid "Choose a contact, wire or coil in the palette and click here to put it in."
msgstr "Vyberte v paletě kontakt, vodič nebo cívku a klepnutím jej sem vložte."

msgid "Closed for one program cycle when its operand goes from 0 to 1."
msgstr "Sepne na jeden cyklus programu, když se jeho operand změní z 0 na 1."

msgid "Closed for one program cycle when its operand goes from 1 to 0."
msgstr "Sepne na jeden cyklus programu, když se jeho operand změní z 1 na 0."

msgid "Its operand is 0 while the coil gets power, 1 otherwise."
msgstr "Jeho operand je 0, dokud cívka dostává proud, jinak 1."

msgid "Add a strip terminal here"
msgstr "Přidat svorku svorkovnice"

#, c-format
msgid "Remove strip terminal %s"
msgstr "Odebrat svorku %s"

msgid "Move the picked terminals one place left"
msgstr "Posunout vybrané svorky o místo doleva"

msgid "Move the picked terminals one place right"
msgstr "Posunout vybrané svorky o místo doprava"
